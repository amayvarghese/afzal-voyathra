# ── Database ─────────────────────────────────────────────────────────────
# MongoDB Atlas → Connect → Drivers → copy the connection string
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="voyathra"

# ── Admin login ──────────────────────────────────────────────────────────
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-strong-password"
# 32+ random characters. Generate with:  openssl rand -base64 48
AUTH_SECRET=""

# ── AI document import (Groq) ────────────────────────────────────────────
# https://console.groq.com/keys
GROQ_API_KEY=""
# Optional overrides (defaults shown)
# GROQ_MODEL="openai/gpt-oss-120b"
# GROQ_FALLBACK_MODEL="llama-3.3-70b-versatile"

# ── Email (Gmail) ────────────────────────────────────────────────────────
# Requires 2-Step Verification, then create an App Password:
# https://myaccount.google.com/apppasswords
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
# Where new-response emails go by default (comma separated). Defaults to GMAIL_USER.
NOTIFY_EMAILS=""
# Sender name shown in inboxes
MAIL_FROM_NAME="Voyathra Travel & Tourism"

# ── File uploads (Vercel Blob) ───────────────────────────────────────────
# Vercel → Storage → Create → Blob → connect to project (sets this automatically)
BLOB_READ_WRITE_TOKEN=""

# ── Branding / URLs ──────────────────────────────────────────────────────
NEXT_PUBLIC_BRAND_NAME="Voyathra Travel & Tourism"
# Public base URL used in email links, e.g. https://forms.yourdomain.com (optional on Vercel)
APP_URL=""
